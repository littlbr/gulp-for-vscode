{
    "name": "gulp-for-vscode",
    "displayName": "Gulp for VS Code",
    "description": "Liste les tâches Gulp, les lance, les arrête et les relance, avec un statut clair.",
    "version": "0.3.5",
    "publisher": "digital-cover",
    "author": { "name": "Martin Vauchel", "url": "https://github.com/littlbr" },
    "homepage": "https://github.com/littlbr/gulp-for-vscode#readme",
    "repository": { "type": "git", "url": "https://github.com/littlbr/gulp-for-vscode.git" },
    "bugs": { "url": "https://github.com/littlbr/gulp-for-vscode/issues" },
    "license": "MIT",
    "icon": "media/icon.png",
    "engines": { "vscode": "^1.90.0" },
    "categories": ["Other"],
    "keywords": ["gulp", "task", "runner", "watch"],
    "main": "./src/extension.js",
    "activationEvents": ["onStartupFinished"],
    "scripts": {
        "package": "npx @vscode/vsce package --out releases/"
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                { "id": "gulpRunner", "title": "Gulp", "icon": "media/icon.svg" }
            ]
        },
        "views": {
            "gulpRunner": [
                { "id": "gulpRunner.tasks", "name": "Tâches Gulp", "type": "webview" }
            ]
        },
        "configuration": {
            "title": "Gulp for VS Code",
            "properties": {
                "gulpRunner.statusBarClickAction": {
                    "type": "string",
                    "enum": ["view", "terminal"],
                    "enumDescriptions": [
                        "Afficher la vue Gulp de l'extension",
                        "Afficher ou masquer le terminal de la tâche en cours"
                    ],
                    "default": "view",
                    "description": "Action au clic sur l'indicateur Gulp de la barre d'état."
                }
            }
        },
        "commands": [
            { "command": "gulpRunner.configureStatusBar", "title": "Gulp : action au clic sur la barre d'état", "icon": "$(gear)" },
            { "command": "gulpRunner.statusBarClick", "title": "Gulp : clic sur la barre d'état" },
            { "command": "gulpRunner.refresh", "title": "Gulp : rafraîchir les tâches", "icon": "$(refresh)" }
        ],
        "menus": {
            "view/title": [
                { "command": "gulpRunner.configureStatusBar", "when": "view == gulpRunner.tasks", "group": "navigation@2" },
                { "command": "gulpRunner.refresh", "when": "view == gulpRunner.tasks", "group": "navigation@1" }
            ],
            "commandPalette": [
                { "command": "gulpRunner.statusBarClick", "when": "false" }
            ]
        }
    }
}
