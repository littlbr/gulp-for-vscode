{
    "name": "gulp-for-vscode",
    "displayName": "Gulp for VS Code",
    "description": "%description%",
    "version": "0.4.0",
    "publisher": "digital-cover",
    "author": { "name": "Martin Vauchel", "url": "https://github.com/littlbr" },
    "homepage": "https://github.com/littlbr/gulp-for-vscode#readme",
    "repository": { "type": "git", "url": "https://github.com/littlbr/gulp-for-vscode.git" },
    "bugs": { "url": "https://github.com/littlbr/gulp-for-vscode/issues" },
    "license": "MIT",
    "icon": "media/icon.png",
    "engines": { "vscode": "^1.90.0" },
    "categories": ["Other"],
    "keywords": ["gulp", "task", "runner", "watch"],
    "main": "./src/extension.js",
    "l10n": "./l10n",
    "activationEvents": ["onStartupFinished"],
    "scripts": {
        "package": "npx @vscode/vsce package --out releases/"
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                { "id": "gulpRunner", "title": "Gulp", "icon": "media/icon.svg" }
            ]
        },
        "views": {
            "gulpRunner": [
                { "id": "gulpRunner.tasks", "name": "%view.tasks%", "type": "webview" }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "gulpRunner.statusBarClickAction": {
                    "type": "string",
                    "enum": ["view", "terminal"],
                    "enumDescriptions": [
                        "%config.statusBarClickAction.view%",
                        "%config.statusBarClickAction.terminal%"
                    ],
                    "default": "view",
                    "description": "%config.statusBarClickAction%"
                }
            }
        },
        "commands": [
            { "command": "gulpRunner.configureStatusBar", "title": "%command.configureStatusBar%", "category": "Gulp", "icon": "$(gear)" },
            { "command": "gulpRunner.statusBarClick", "title": "%command.statusBarClick%", "category": "Gulp" },
            { "command": "gulpRunner.refresh", "title": "%command.refresh%", "category": "Gulp", "icon": "$(refresh)" }
        ],
        "menus": {
            "view/title": [
                { "command": "gulpRunner.configureStatusBar", "when": "view == gulpRunner.tasks", "group": "navigation@2" },
                { "command": "gulpRunner.refresh", "when": "view == gulpRunner.tasks", "group": "navigation@1" }
            ],
            "commandPalette": [
                { "command": "gulpRunner.statusBarClick", "when": "false" }
            ]
        }
    }
}
